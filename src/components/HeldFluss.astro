---
/**
 * Hintergrund des Heros nach „Auralis": ein fließender Indigo-/Cyan-Verlauf
 * (WebGL-Shader) hinter fünf Glas-Streifen, die zur Seite hin klarer werden.
 *
 * - Ohne three.js: ein einziger Fragment-Shader auf einem Dreieck (~2 KB).
 * - Läuft nur, solange der Hero sichtbar und der Tab aktiv ist.
 * - „Bewegung reduzieren": ein stehendes Bild statt Animation.
 * - Ohne WebGL: CSS-Verlauf als Ersatz.
 */
---

<div class="fluss" aria-hidden="true">
  <canvas class="fluss-leinwand"></canvas>
  <div class="streifen">
    <span></span><span></span><span></span><span></span><span></span>
  </div>
</div>

<script>
  const VERTEX = `attribute vec2 p; void main(){ gl_Position = vec4(p, 0.0, 1.0); }`;
  // Simplex-Rauschen wie in der Referenz; Farben: Indigo, Cyan, tiefes Blau.
  const FRAGMENT = `
    precision mediump float;
    uniform float u_time;
    uniform vec2 u_res;
    vec3 permute(vec3 x){ return mod(((x*34.0)+1.0)*x, 289.0); }
    float snoise(vec2 v){
      const vec4 C = vec4(0.211324865405187, 0.366025403784439, -0.577350269189626, 0.024390243902439);
      vec2 i = floor(v + dot(v, C.yy));
      vec2 x0 = v - i + dot(i, C.xx);
      vec2 i1 = (x0.x > x0.y) ? vec2(1.0, 0.0) : vec2(0.0, 1.0);
      vec4 x12 = x0.xyxy + C.xxzz; x12.xy -= i1;
      i = mod(i, 289.0);
      vec3 p = permute(permute(i.y + vec3(0.0, i1.y, 1.0)) + i.x + vec3(0.0, i1.x, 1.0));
      vec3 m = max(0.5 - vec3(dot(x0,x0), dot(x12.xy,x12.xy), dot(x12.zw,x12.zw)), 0.0);
      m = m*m; m = m*m;
      vec3 x = 2.0 * fract(p * C.www) - 1.0; vec3 h = abs(x) - 0.5;
      vec3 ox = floor(x + 0.5); vec3 a0 = x - ox;
      m *= 1.79284291400159 - 0.85373472095314 * (a0*a0 + h*h);
      vec3 g; g.x = a0.x * x0.x + h.x * x0.y; g.yz = a0.yz * x12.xz + h.yz * x12.yw;
      return 130.0 * dot(m, g);
    }
    void main(){
      vec2 uv = gl_FragCoord.xy / u_res.xy;
      float n = snoise(uv * 2.5 + vec2(u_time * 0.4, u_time * 0.5));
      float n2 = snoise(uv * 1.5 - vec2(u_time * 0.3, u_time * 0.2));
      vec3 indigo = vec3(0.31, 0.27, 0.90);
      vec3 cyan = vec3(0.02, 0.71, 0.83);
      vec3 tief = vec3(0.15, 0.10, 0.50);
      vec3 farbe = mix(tief, indigo, smoothstep(-0.6, 0.8, n));
      farbe = mix(farbe, cyan, smoothstep(-0.4, 0.9, n2) * 0.8);
      float alpha = smoothstep(-0.2, 0.6, uv.x);
      gl_FragColor = vec4(farbe * alpha, alpha);
    }`;

  function starte(huelle: HTMLElement) {
    const canvas = huelle.querySelector("canvas") as HTMLCanvasElement;
    const gl = canvas.getContext("webgl", { alpha: true, antialias: false, premultipliedAlpha: true });
    if (!gl) {
      huelle.classList.add("ohne-webgl");
      return;
    }
    const shader = (typ: number, quelle: string) => {
      const s = gl.createShader(typ)!;
      gl.shaderSource(s, quelle);
      gl.compileShader(s);
      return gl.getShaderParameter(s, gl.COMPILE_STATUS) ? s : null;
    };
    const vs = shader(gl.VERTEX_SHADER, VERTEX);
    const fs = shader(gl.FRAGMENT_SHADER, FRAGMENT);
    const prog = gl.createProgram()!;
    if (!vs || !fs) {
      huelle.classList.add("ohne-webgl");
      return;
    }
    gl.attachShader(prog, vs);
    gl.attachShader(prog, fs);
    gl.linkProgram(prog);
    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) {
      huelle.classList.add("ohne-webgl");
      return;
    }
    gl.useProgram(prog);
    const puffer = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, puffer);
    // Ein Dreieck, das den ganzen Bildschirm abdeckt.
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    const pos = gl.getAttribLocation(prog, "p");
    gl.enableVertexAttribArray(pos);
    gl.vertexAttribPointer(pos, 2, gl.FLOAT, false, 0, 0);
    const uZeit = gl.getUniformLocation(prog, "u_time");
    const uRes = gl.getUniformLocation(prog, "u_res");

    // Halbe Auflösung reicht für einen weichen Verlauf und schont den Akku.
    const groesse = () => {
      const r = canvas.getBoundingClientRect();
      const f = Math.min(window.devicePixelRatio || 1, 2) * 0.5;
      canvas.width = Math.max(1, Math.round(r.width * f));
      canvas.height = Math.max(1, Math.round(r.height * f));
      gl.viewport(0, 0, canvas.width, canvas.height);
      gl.uniform2f(uRes, canvas.width, canvas.height);
    };
    const zeichne = (t: number) => {
      gl.uniform1f(uZeit, t);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
    };

    const ruhig = matchMedia("(prefers-reduced-motion: reduce)");
    let sichtbar = true;
    let laeuft = false;
    let start = performance.now();
    const schleife = (jetzt: number) => {
      if (!sichtbar || document.hidden || ruhig.matches) {
        laeuft = false;
        return;
      }
      zeichne((jetzt - start) * 0.0011);
      requestAnimationFrame(schleife);
    };
    const weiter = () => {
      if (ruhig.matches) {
        zeichne(7.0);
        return;
      }
      if (!laeuft && sichtbar && !document.hidden) {
        laeuft = true;
        requestAnimationFrame(schleife);
      }
    };

    groesse();
    zeichne(7.0);
    new ResizeObserver(() => {
      groesse();
      zeichne(ruhig.matches ? 7.0 : (performance.now() - start) * 0.0011);
    }).observe(canvas);
    new IntersectionObserver(([e]) => {
      sichtbar = e.isIntersecting;
      weiter();
    }).observe(huelle);
    document.addEventListener("visibilitychange", weiter);
    ruhig.addEventListener("change", () => {
      start = performance.now();
      weiter();
    });
    huelle.classList.add("bereit");
    weiter();
  }

  document.querySelectorAll<HTMLElement>(".fluss").forEach(starte);
</script>

<style>
  .fluss {
    position: absolute;
    inset: 0 0 0 auto;
    width: 70%;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .fluss-leinwand {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.2s var(--ease);
  }
  .fluss.bereit .fluss-leinwand {
    opacity: 1;
  }
  /* Ersatz ohne WebGL: stehender Verlauf in denselben Farben. */
  .fluss.ohne-webgl {
    background: radial-gradient(120% 90% at 85% 40%, #4f46e5 0%, #06b6d4 38%, transparent 72%);
    opacity: 0.85;
  }
  .streifen {
    position: absolute;
    inset: 0;
    display: flex;
  }
  .streifen span {
    flex: 1;
    height: 100%;
    border-left: 1px solid color-mix(in srgb, var(--bg) 55%, transparent);
  }
  .streifen span:nth-child(1) {
    border-left-color: transparent;
    background: linear-gradient(to right, var(--bg) 0%, color-mix(in srgb, var(--bg) 85%, transparent) 100%);
  }
  .streifen span:nth-child(2) {
    background: linear-gradient(to right, color-mix(in srgb, var(--bg) 85%, transparent), color-mix(in srgb, var(--bg) 65%, transparent));
    backdrop-filter: blur(16px);
    box-shadow: -15px 0 30px -10px var(--bg);
  }
  .streifen span:nth-child(3) {
    background: linear-gradient(to right, color-mix(in srgb, var(--bg) 65%, transparent), color-mix(in srgb, var(--bg) 40%, transparent));
    backdrop-filter: blur(12px);
    box-shadow: -15px 0 30px -10px color-mix(in srgb, var(--bg) 90%, transparent);
  }
  .streifen span:nth-child(4) {
    background: linear-gradient(to right, color-mix(in srgb, var(--bg) 40%, transparent), color-mix(in srgb, var(--bg) 15%, transparent));
    backdrop-filter: blur(6px);
    box-shadow: -15px 0 30px -10px color-mix(in srgb, var(--bg) 60%, transparent);
  }
  .streifen span:nth-child(5) {
    background: linear-gradient(to right, color-mix(in srgb, var(--bg) 15%, transparent), color-mix(in srgb, var(--bg) 2%, transparent));
    backdrop-filter: blur(2px);
    box-shadow: -15px 0 30px -10px color-mix(in srgb, var(--bg) 30%, transparent);
  }
  @media (max-width: 900px) {
    .fluss {
      width: 120%;
      transform: translateX(12%);
      opacity: 0.4;
    }
  }
</style>
