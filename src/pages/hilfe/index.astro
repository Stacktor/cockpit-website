---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Seitenkopf from "../../components/Seitenkopf.astro";
import Icon from "../../components/Icon.astro";
import Faq from "../../components/Faq.astro";
import { SITE } from "../../config";

const artikel = (await getCollection("hilfe")).sort((a, b) => a.data.reihenfolge - b.data.reihenfolge);
const fragen = [
  { frage: "Läuft cockpit ohne Internet?", antwort: "<p>Ja. Pipeline, Profil, Anschreiben-Bearbeitung, Erinnerungen und Auswertung laufen komplett offline. Online brauchst du nur, was von Natur aus online ist: Stellensuche, KI mit Anbieter-Schlüssel, dein Postfach und gelegentlich die Lizenzprüfung.</p>" },
  { frage: "Auf wie vielen Geräten kann ich cockpit nutzen?", antwort: "<p>Mit einer Lizenz auf bis zu drei Rechnern. Unter <i>Einstellungen → Lizenz</i> meldest du ein Gerät ab und gibst den Platz frei.</p>" },
  { frage: "Kann ich meine Daten aus cockpit herausholen?", antwort: '<p>Jederzeit: <i>Einstellungen → Sicherungen → Umzug per Datei → Als Datei speichern</i>. Die automatischen Sicherungen liegen außerdem offen lesbar in <i>Dokumente/Cockpit Backups</i>. Siehe <a href="/hilfe/daten-sichern/">Daten sichern</a>.</p>' },
  { frage: "Welche KI-Anbieter werden unterstützt?", antwort: '<p>Anthropic (Claude), OpenAI, Google Gemini, Perplexity und xAI mit eigenem Schlüssel, oder lokal über Ollama und LM Studio. Siehe <a href="/hilfe/ki-einrichten/">KI einrichten</a>.</p>' },
  { frage: "Verschickt cockpit Bewerbungen von selbst?", antwort: "<p>Nicht ohne dich. Standard ist <i>Freigabe</i>: cockpit bereitet vor, du bestätigst jede einzelne Mail. Ein Not-Aus stoppt alle automatischen Abläufe.</p>" },
  { frage: "Ich habe einen Fehler gefunden. Wohin damit?", antwort: `<p>Als Alpha-Tester direkt in der App: <i>Feedback geben → Fehler melden</i>. Sonst gern per Mail an <a href="mailto:${SITE.mail}">${SITE.mail}</a>.</p>` },
];
---

<Base title="Hilfe-Center" description="Hilfe zu cockpit: Installation, KI einrichten, Alpha-Schlüssel, Daten sichern und Lösungen für häufige Probleme.">
  <Seitenkopf
    eyebrow="Hilfe-Center"
    titel="Wie können wir helfen?"
    lead="Anleitungen für den Start und Lösungen für die häufigsten Stolpersteine. Nichts gefunden? Schreib mir."
    krumen={[["Hilfe", "/hilfe/"]]}
  />

  <section class="abschnitt">
    <div class="wrap">
      <div class="raster r3">
        {
          artikel.map((a, i) => (
            <a href={`/hilfe/${a.id}/`} class="karte rv" style={`--d:${i % 3}`}>
              <div class="ic">
                <Icon name={a.data.icon} />
              </div>
              <h2 class="klein">{a.data.titel}</h2>
              <p>{a.data.beschreibung}</p>
              <span class="mehr">
                Lesen <Icon name="arrow-right" size={15} />
              </span>
            </a>
          ))
        }
        <a href={`mailto:${SITE.mail}`} class="karte kontakt rv" style="--d:2">
          <div class="ic"><Icon name="mail" /></div>
          <h2 class="klein">Direkt fragen</h2>
          <p>Ich antworte persönlich, meist innerhalb eines Tages.</p>
          <span class="mehr">{SITE.mail} <Icon name="arrow-right" size={15} /></span>
        </a>
      </div>
    </div>
  </section>

  <section class="abschnitt soft" id="faq">
    <div class="wrap eng">
      <div class="abschnitt-kopf">
        <div class="eyebrow">Häufige Fragen</div>
        <h2>Kurz beantwortet</h2>
      </div>
      <Faq fragen={fragen} />
    </div>
  </section>
</Base>

<style>
  h2.klein {
    font-size: 17.5px;
    margin-bottom: 6px;
  }
  .kontakt {
    border-style: dashed;
  }
</style>
