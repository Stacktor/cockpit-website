---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Seitenkopf from "../../components/Seitenkopf.astro";
import Icon from "../../components/Icon.astro";

export async function getStaticPaths() {
  const alle = (await getCollection("hilfe")).sort((a, b) => a.data.reihenfolge - b.data.reihenfolge);
  return alle.map((a) => ({ params: { slug: a.id }, props: { a, alle } }));
}
const { a, alle } = Astro.props;
const { Content, headings } = await render(a);
const inhalt = headings.filter((h) => h.depth === 2);
---

<Base title={`${a.data.titel} · Hilfe`} description={a.data.beschreibung}>
  <Seitenkopf
    eyebrow="Hilfe-Center"
    titel={a.data.titel}
    lead={a.data.beschreibung}
    krumen={[
      ["Hilfe", "/hilfe/"],
      [a.data.titel, `/hilfe/${a.id}/`],
    ]}
  />
  <section class="abschnitt">
    <div class="wrap hilfe-raster">
      <aside class="seitenleiste">
        {
          inhalt.length > 1 && (
            <nav aria-label="Auf dieser Seite">
              <p class="micro titel">Auf dieser Seite</p>
              <ul>
                {inhalt.map((h) => (
                  <li>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }
        <nav aria-label="Weitere Artikel">
          <p class="micro titel">Hilfe-Artikel</p>
          <ul>
            {
              alle.map((x) => (
                <li>
                  <a href={`/hilfe/${x.id}/`} aria-current={x.id === a.id ? "page" : undefined}>
                    <Icon name={x.data.icon} size={15} /> {x.data.titel}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </aside>
      <article class="prosa">
        <Content />
        <div class="hinweis" style="margin-top:40px">
          <b>Hat das geholfen?</b>
          Wenn nicht, schreib mir an <a href="mailto:Kontakt@mesco.cc">Kontakt@mesco.cc</a> — ich ergänze den Artikel.
        </div>
      </article>
    </div>
  </section>
</Base>

<style>
  .hilfe-raster {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    gap: 56px;
    max-width: 1040px;
  }
  .seitenleiste {
    position: sticky;
    top: 90px;
    align-self: start;
    display: grid;
    gap: 28px;
    font-size: 14px;
  }
  .titel {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 700;
    font-size: 11.5px;
    margin-bottom: 8px;
  }
  .seitenleiste ul {
    list-style: none;
    display: grid;
    gap: 2px;
  }
  .seitenleiste a {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 10px;
    border-radius: 8px;
    color: var(--muted);
    text-decoration: none;
  }
  .seitenleiste a:hover {
    background: var(--soft);
    color: var(--ink);
  }
  .seitenleiste a[aria-current="page"] {
    background: var(--accent-soft);
    color: var(--accent-ink);
    font-weight: 600;
  }
  .prosa :global(h2) {
    scroll-margin-top: 90px;
  }
  @media (max-width: 860px) {
    .hilfe-raster {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .seitenleiste {
      position: static;
      order: 2;
    }
  }
</style>
