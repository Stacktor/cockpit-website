---
import Base from "../layouts/Base.astro";
import Seitenkopf from "../components/Seitenkopf.astro";
import Icon from "../components/Icon.astro";
import { SITE } from "../config";

const werte = [
  { icon: "lock", titel: "Deine Daten gehören dir", text: "cockpit speichert alles in einer Datenbank auf deinem Rechner. Es gibt keinen Server, der Bewerbungen, Lebenslauf oder Mails annimmt." },
  { icon: "wallet", titel: "Faire Preise", text: "Ohne Server- und KI-Kosten pro Nutzer muss cockpit kein Abo sein. Der Preis wird mit den Alpha-Testern festgelegt." },
  { icon: "check", titel: "Nachvollziehbar", text: "Was nicht fertig ist, ist als „in Arbeit“ gekennzeichnet. Welche Daten cockpit wohin sendet, steht vollständig in der Datenschutzerklärung." },
  { icon: "users", titel: "Mit den Nutzern entwickelt", text: "Die Roadmap richtet sich nach den Rückmeldungen der Menschen, die cockpit täglich einsetzen." },
];
---

<Base title="Über cockpit" description="Wer Bewerbungs-Cockpit entwickelt, welches Problem die App löst und nach welchen Grundsätzen sie gebaut ist.">
  <Seitenkopf eyebrow="Über cockpit" titel="Bewerbungen als Projekt führen, mit Daten auf dem eigenen Rechner." krumen={[["Über", "/ueber/"]]} />
  <section class="abschnitt">
    <div class="wrap eng prosa">
      <p class="lead" style="color:var(--ink-2)">
        Bewerbungs-Cockpit ist eine Desktop-App für den gesamten Bewerbungsprozess. Entwickelt wird sie von Thomas Graf in Delmenhorst, unabhängig und ohne Investoren.
      </p>
      <p>
        Ausgangspunkt ist eine einfache Beobachtung: Eine Jobsuche ist Projektarbeit, die Werkzeuge dafür sind aber entweder Tabellen, die niemand pflegt, oder Cloud-Dienste, die Lebenslauf, Gehaltswunsch und jede Absage auf fremden Servern speichern.
      </p>
      <p>
        cockpit verbindet die einzelnen Schritte in einer Anwendung: Stellen aus mehreren Quellen suchen und bewerten, Anschreiben und Lebenslauf je Stelle erstellen, Bewerbungen und Termine verfolgen, Mails einordnen und Gespräche vorbereiten. Die Daten liegen lokal. Die KI kommt über einen eigenen Schlüssel oder läuft vollständig auf dem Rechner.
      </p>
      <p>
        Derzeit läuft die <a href="/alpha/">Alpha</a> mit {SITE.alphaPlaetze} Plätzen für Menschen, die aktiv suchen. Ihre Rückmeldungen bestimmen, was bis zur ersten stabilen Version fertig wird.
      </p>
    </div>
  </section>

  <section class="abschnitt soft">
    <div class="wrap">
      <div class="abschnitt-kopf">
        <div class="eyebrow rv">Wofür cockpit steht</div>
        <h2 class="rv" style="--d:1">Vier Grundsätze</h2>
      </div>
      <div class="raster r4">
        {
          werte.map((w, i) => (
            <div class="karte rv" style={`--d:${i}`}>
              <div class="ic">
                <Icon name={w.icon} />
              </div>
              <h3>{w.titel}</h3>
              <p>{w.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="abschnitt">
    <div class="wrap eng center">
      <h2 class="rv">Kontakt</h2>
      <p class="lead rv" style="--d:1">Fragen, Vorschläge und Fehlerberichte gehen direkt an die Entwicklung. Antwort in der Regel innerhalb eines Werktags.</p>
      <div class="knoepfe rv" style="--d:2">
        <a href={`mailto:${SITE.mail}`} class="btn btn-p"><Icon name="mail" size={17} /> {SITE.mail}</a>
        {SITE.discord && <a href={SITE.discord} class="btn btn-s"><Icon name="message-circle" size={17} /> Discord</a>}
      </div>
      <p class="micro" style="margin-top:18px">Anbieterangaben im <a href="/impressum/">Impressum</a>.</p>
    </div>
  </section>
</Base>

<style>
  .knoepfe {
    display: flex;
    gap: 10px;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 22px;
  }
</style>
