---
import Base from "../layouts/Base.astro";
import Seitenkopf from "../components/Seitenkopf.astro";
import Icon from "../components/Icon.astro";
import Faq from "../components/Faq.astro";

const fragen = [
  { frage: "Warum steht der Preis noch nicht fest?", antwort: "<p>Weil er mit den Menschen festgelegt wird, die cockpit wirklich benutzen. Alpha-Tester beantworten nach zwei Wochen in der App einen Fragebogen. Darin geht es unter anderem darum, ab welchem Preis cockpit zu billig, günstig, teuer oder zu teuer wäre und ob sie lieber einmal kaufen oder ein Abo hätten. Daraus ergibt sich der Preis zum Start.</p>" },
  { frage: "Einmalkauf oder Abo?", antwort: "<p>Auch das ist offen und Teil der Umfrage. Fest steht: Weil cockpit keine Server und keine KI-Kosten pro Nutzer hat, muss es kein Abo sein.</p>" },
  { frage: "Bleibt die kostenlose Version wirklich kostenlos?", antwort: "<p>Ja, dauerhaft und ohne Grenze bei den Bewerbungen. Pipeline, Stellensuche, Kontakte, Aufgaben, Stichwort-Abgleich, Anschreiben mit deiner KI, Interview-Training und der Sync über einen eigenen Ordner bleiben frei.</p>" },
  { frage: "Was bringt Pro?", antwort: '<p>Komfort für alle, die viel bewerben: den Auto-Modus, der Bewerbungen vorbereitet, den cockpit-Sync-Server (Sync ohne eigenen Cloud-Ordner), den Lebenslauf je Stelle, das automatische Ausfüllen von Formularen mit der Browser-Erweiterung und die erweiterte Analyse. <a href="/vergleich/">Vergleich mit Teal und Huntr</a></p>' },
  { frage: "Was passiert mit meiner Alpha-Lizenz nach der Alpha?", antwort: "<p>Wer bis zum Ende dabei ist und ehrlich Rückmeldung gibt, behält die Vollversion dauerhaft, auch mit allen späteren Updates.</p>" },
  { frage: "Bekomme ich eine ordentliche Rechnung?", antwort: "<p>Ja. Verkauft wird über Lemon Squeezy als Händler; du bekommst automatisch eine Rechnung mit korrekt ausgewiesener Umsatzsteuer. Unternehmen können ihre USt-IdNr. angeben.</p>" },
  { frage: "Kann ich zurückgeben?", antwort: '<p>Sobald der Verkauf startet: 30 Tage Geld zurück, ohne Begründung, eine Mail genügt. Einzelheiten in der <a href="/widerruf/">Widerrufsbelehrung</a>.</p>' },
];
---

<Base title="Preise" description="cockpit: Bewerbungen ohne Grenze und dauerhaft kostenlos. Pro bringt Komfortfunktionen; der Preis wird mit den Alpha-Testern festgelegt.">
  <Seitenkopf
    eyebrow="Preise"
    titel="Bewerben kostet nichts. Den Preis für Pro legen die Tester mit fest."
    lead="Bewerbungen verfolgen ist kostenlos, ohne Grenze. Pro bringt Komfortfunktionen wie den Auto-Modus und den Sync-Server."
    krumen={[["Preise", "/preise/"]]}
    zentriert
  />

  <section class="abschnitt">
    <div class="wrap">
      <div class="plaene">
        <div class="plan rv">
          <div class="name">Kostenlos</div>
          <div class="preis">0 <small>€ dauerhaft</small></div>
          <p class="notiz">Alles, was du zum Bewerben brauchst. Ohne Grenze bei den Bewerbungen.</p>
          <a href="/download/" class="btn btn-s">Herunterladen</a>
          <ul>
            <li><Icon name="check" size={17} /> Bewerbungen ohne Grenze, mit Kontakten und Aufgaben</li>
            <li><Icon name="check" size={17} /> Stellensuche mit Arbeitsagentur und Stichwort-Abgleich</li>
            <li><Icon name="check" size={17} /> Anschreiben und Interview-Training mit deiner KI</li>
            <li><Icon name="check" size={17} /> Browser-Erweiterung: Stellen mit einem Klick speichern</li>
            <li><Icon name="check" size={17} /> Sync über deinen eigenen Cloud-Ordner, verschlüsselt</li>
          </ul>
        </div>

        <div class="plan hi rv" style="--d:1">
          <div class="flagge">Jetzt: Alpha</div>
          <div class="name">Alpha-Tester</div>
          <div class="preis">0 <small>€ · alles frei</small></div>
          <p class="notiz">Für Menschen, die gerade suchen und ehrlich Rückmeldung geben.</p>
          <a href="/alpha/" class="btn btn-p">Alpha-Zugang anfragen</a>
          <ul>
            <li><Icon name="check" size={17} /> <b>Alle Funktionen, keine Grenzen</b></li>
            <li><Icon name="check" size={17} /> Bis zu 3 Geräte</li>
            <li><Icon name="check" size={17} /> Du bestimmst Preis und Funktionen mit</li>
            <li><Icon name="check" size={17} /> Vollversion dauerhaft behalten, wenn du bis zum Ende dabei bist</li>
          </ul>
        </div>

        <div class="plan rv" style="--d:2">
          <div class="name">Pro</div>
          <div class="preis">Preis <small>noch offen</small></div>
          <p class="notiz">Komfort für alle, die viel bewerben. Ab dem Verkaufsstart; Einmalkauf oder Abo entscheiden die Alpha-Tester mit.</p>
          <span class="btn btn-s" aria-disabled="true">Ab Verkaufsstart</span>
          <ul>
            <li><Icon name="check" size={17} /> Alles aus Kostenlos</li>
            <li><Icon name="check" size={17} /> Auto-Modus: passende Stellen, Bewerbung vorbereitet</li>
            <li><Icon name="check" size={17} /> Lebenslauf je Stelle mit KI</li>
            <li><Icon name="check" size={17} /> Formulare ausfüllen mit der Erweiterung</li>
            <li><Icon name="check" size={17} /> cockpit-Sync-Server, bis zu 3 Geräte</li>
            <li><Icon name="check" size={17} /> Erweiterte Analyse</li>
          </ul>
        </div>
      </div>

      <div class="versprechen raster r3">
        <div class="rv"><Icon name="shield-check" /><p><b>Du verlierst nie, wofür du bezahlt hast.</b> Gekauftes wird nicht nachträglich gesperrt.</p></div>
        <div class="rv" style="--d:1"><Icon name="wallet" /><p><b>30 Tage Geld zurück</b>, sobald der Verkauf startet. Eine Mail genügt.</p></div>
        <div class="rv" style="--d:2"><Icon name="file-text" /><p><b>Ordentliche Rechnung</b> mit ausgewiesener Umsatzsteuer über Lemon Squeezy.</p></div>
      </div>
    </div>
  </section>

  <section class="abschnitt soft">
    <div class="wrap eng">
      <div class="abschnitt-kopf">
        <div class="eyebrow">Fragen zum Preis</div>
        <h2>Was du wissen solltest</h2>
      </div>
      <Faq fragen={fragen} ersteOffen />
    </div>
  </section>
</Base>

<style>
  .plaene {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    align-items: start;
  }
  .plan {
    position: relative;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    padding: 28px;
    box-shadow: var(--shadow-1);
    transition:
      transform 0.3s var(--ease),
      box-shadow 0.3s;
  }
  .plan:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-2);
  }
  .plan.hi {
    border: 2px solid var(--accent);
    box-shadow: var(--glow);
  }
  @media (prefers-reduced-motion: no-preference) {
    .plan.hi {
      animation: atmen 5s ease-in-out 1.5s infinite;
    }
    @keyframes atmen {
      50% {
        box-shadow: 0 18px 46px -14px color-mix(in srgb, var(--accent) 55%, transparent);
      }
    }
  }
  .flagge {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--accent);
    color: var(--on-accent);
    font-size: 12px;
    font-weight: 700;
    padding: 4px 14px;
    border-radius: 999px;
    white-space: nowrap;
  }
  .name {
    font-size: 14px;
    font-weight: 700;
    color: var(--muted);
    margin-bottom: 8px;
  }
  .preis {
    font-size: 40px;
    font-weight: 750;
    letter-spacing: -0.035em;
  }
  .preis small {
    font-size: 15px;
    font-weight: 520;
    color: var(--muted);
    letter-spacing: 0;
  }
  .notiz {
    font-size: 14px;
    color: var(--muted);
    margin: 8px 0 18px;
    min-height: 42px;
  }
  .plan .btn {
    width: 100%;
  }
  .plan ul {
    list-style: none;
    margin-top: 20px;
    display: grid;
    gap: 10px;
    font-size: 14.5px;
    color: var(--ink-2);
  }
  .plan li {
    display: flex;
    gap: 10px;
  }
  .plan li :global(svg) {
    color: var(--ok);
    flex: none;
    margin-top: 3px;
  }
  .plan li.offen {
    color: var(--muted);
  }
  .plan li.offen :global(svg) {
    color: var(--faint);
  }
  .versprechen {
    margin-top: 48px;
  }
  .versprechen > div {
    display: flex;
    gap: 14px;
    font-size: 14.5px;
    color: var(--muted);
  }
  .versprechen :global(svg) {
    color: var(--accent-ink);
    flex: none;
  }
  .versprechen b {
    color: var(--ink);
  }
  @media (max-width: 900px) {
    .plaene {
      grid-template-columns: 1fr;
      max-width: 460px;
      margin: 0 auto;
    }
    .plan.hi {
      order: -1;
    }
  }
</style>
