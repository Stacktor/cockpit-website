---
import Base from "../layouts/Base.astro";
import Rechtstext from "../components/Rechtstext.astro";
import html from "../legal/danke.html?raw";
---

<Base title="Danke! So schaltest du cockpit frei" description="Nach dem Kauf: Lizenzschlüssel eintragen und loslegen." noindex>
  <Rechtstext html={html} />
</Base>

<style is:global>
  .rechtstext .tick {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--ok-soft);
    color: var(--ok);
    display: grid;
    place-items: center;
    font-size: 28px;
    font-weight: 800;
    margin-bottom: 22px;
  }
  .rechtstext .lead {
    margin-bottom: 30px;
  }
  .rechtstext .steps {
    counter-reset: s;
    list-style: none;
    margin: 8px 0 0;
  }
  .rechtstext .steps li {
    counter-increment: s;
    position: relative;
    padding: 0 0 22px 46px;
    border-left: 2px solid var(--line);
    margin-left: 14px;
  }
  .rechtstext .steps li:last-child {
    border-left-color: transparent;
    padding-bottom: 0;
  }
  .rechtstext .steps li::before {
    content: counter(s);
    position: absolute;
    left: -15px;
    top: -2px;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--accent);
    color: #fff;
    font-size: 14px;
    font-weight: 700;
    display: grid;
    place-items: center;
  }
  .rechtstext .steps b {
    display: block;
    margin-bottom: 3px;
  }
  .rechtstext .steps span {
    color: var(--muted);
    font-size: 14.5px;
  }
  .rechtstext .key {
    background: var(--soft);
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    padding: 13px 16px;
    font-family: var(--mono);
    font-size: 14.5px;
    color: var(--muted);
    margin-top: 10px;
    text-align: center;
  }
  .rechtstext .dl {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 14px;
  }
  .rechtstext .btn {
    background: var(--card);
    color: var(--ink);
    border-color: var(--line);
    font-size: 14.5px;
    padding: 11px 19px;
  }
  .rechtstext .btn.p {
    background: var(--accent);
    color: #fff;
    border-color: var(--accent);
  }
  .rechtstext .btn.aus {
    opacity: 0.55;
    pointer-events: none;
  }
  .rechtstext .info {
    background: var(--accent-soft);
    border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
    border-radius: var(--r-sm);
    padding: 16px 18px;
    margin: 22px 0;
    font-size: 14.5px;
  }
  .rechtstext details {
    border-bottom: 1px solid var(--line);
    padding: 15px 0;
  }
  .rechtstext summary {
    cursor: pointer;
    font-weight: 600;
  }
  .rechtstext details p {
    margin-top: 9px;
    color: var(--muted);
    font-size: 14.5px;
  }
</style>
