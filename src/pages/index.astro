---
import { lesezeit } from "../lib/lesezeit";
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import ScreenSlider from "../components/ScreenSlider.astro";
import HeldFluss from "../components/HeldFluss.astro";
import CardRail from "../components/CardRail.astro";
import Faq from "../components/Faq.astro";
import Vergleich from "../components/Vergleich.astro";
import { SITE } from "../config";

const funktionen = (await getCollection("funktionen")).sort((a, b) => a.data.reihenfolge - b.data.reihenfolge);
const beitraege = (await getCollection("blog")).sort((a, b) => +b.data.datum - +a.data.datum).slice(0, 3);

const folien = [
  { id: "start", label: "Start", text: "Kennzahlen, offene Erinnerungen und neue passende Stellen auf einen Blick." },
  { id: "pipeline", label: "Pipeline", text: "Jede Bewerbung als Karte, von „Entwurf“ bis „Abgeschlossen“." },
  { id: "stellen", label: "Stellen", text: "Arbeitsagentur, Arbeitnow, Adzuna und RSS in einer Suche, mit Match-Score." },
  { id: "inbox", label: "Inbox", text: "Bewerbungs-Mails zusammengefasst, einsortiert und mit der Bewerbung verknüpft." },
  { id: "interview", label: "Interview", text: "Üben mit Fragen zur Stelle, Bewertung und Musterantworten." },
  { id: "lebenslauf", label: "Lebenslauf", text: "Aus deinem Profil ein sauberes PDF. Drei Vorlagen, Deutsch oder Englisch." },
];

const quellen = ["Bundesagentur für Arbeit", "Arbeitnow", "Adzuna", "RSS-Feeds", "IMAP-Postfächer", "Anthropic", "OpenAI", "Google Gemini", "Perplexity", "xAI", "Ollama", "LM Studio"];

const fragen = [
  {
    frage: "Was kostet cockpit?",
    antwort:
      "<p>Bewerbungen verfolgen ist kostenlos, ohne Grenze bei der Anzahl. Pro bringt Komfort dazu, etwa den Auto-Modus und den Sync-Server. Was Pro kostet und ob als Einmalkauf oder Abo, lege ich mit den Alpha-Testern fest. Deshalb steht noch kein Preis da. Alpha-Tester, die bis zum Ende Rückmeldung geben, behalten die Vollversion dauerhaft.</p>",
  },
  {
    frage: "Brauche ich einen kostenpflichtigen KI-Zugang?",
    antwort:
      '<p>Nein. Du kannst einen eigenen API-Schlüssel nutzen (meist wenige Cent pro Anschreiben) oder ein lokales Modell über Ollama oder LM Studio, das kostet nichts. Ohne KI funktioniert cockpit auch, dann ohne Entwürfe. <a href="/hilfe/ki-einrichten/">KI einrichten</a></p>',
  },
  {
    frage: "Wo liegen meine Daten?",
    antwort:
      '<p>In einer Datenbank-Datei auf deinem Rechner, Passwörter und Schlüssel im Schlüsselbund deines Betriebssystems. Wenn du mehrere Geräte abgleichst, verschlüsselt cockpit vorher alles mit deiner Passphrase. Weder dein Cloud-Ordner noch der cockpit-Server können die Daten lesen. Sicherungen legt cockpit täglich und vor jedem Update selbst an, in deinem Ordner „Dokumente/Cockpit Backups“. <a href="/blog/warum-local-first/">Warum local-first</a></p>',
  },
  {
    frage: "Gibt es cockpit für den Mac?",
    antwort:
      "<p>Noch nicht. macOS ist in Arbeit, aber mir fehlt gerade ein Mac zum Testen, und ungetestete Installer gebe ich nicht raus. Du kannst dich trotzdem anmelden und kommst auf die Mac-Warteliste.</p>",
  },
  {
    frage: "Wie komme ich in die Alpha?",
    antwort: `<p>Über das <a href="/alpha/">Anmeldeformular</a>. Es gibt ${SITE.alphaPlaetze} Plätze, ich vergebe sie persönlich. Wenn du dabei bist, bekommst du deinen Alpha-Schlüssel per Mail.</p>`,
  },
];
---

<Base
  title="Bewerbungs-Cockpit: Bewerbungen organisieren. Ohne Cloud, ohne Konto."
  description="Der Bewerbungsmanager, der deine Daten auf deinem Gerät lässt: Pipeline, Stellensuche, KI-Anschreiben mit eigenem Schlüssel, Inbox und Interview-Training. Für Windows und Linux."
>
  <!-- ───────── Hero ───────── -->
  <section class="held">
    <HeldFluss />
    <div class="wrap held-inhalt">
      <div class="held-text">
        <a href="/alpha/" class="badge rv an">
          <span class="punkt"></span> Geschlossene {SITE.version} · <span data-alpha-plaetze>{SITE.alphaPlaetze} Plätze</span>
        </a>
        <h1 class="rv an" style="--d:1">
          <span class="zeile">Bewerbungen im Griff.</span> <span class="zeile">Ohne Cloud.</span> <span class="zeile verlauf">Auf deinem Gerät.</span>
        </h1>
        <p class="lead rv an" style="--d:2">
          cockpit bündelt Stellensuche, Bewerbungen, KI-Anschreiben und Interview-Training in einer App. Gespeichert wird alles auf <b>deinem Rechner</b>. Kein Konto, keine Cloud, kein Abo-Zwang.
        </p>
        <div class="cta rv an" style="--d:3">
          <a href="/alpha/" class="btn btn-p btn-lg">Alpha-Zugang anfragen <Icon name="arrow-up-right" size={17} /></a>
          <a href="/funktionen/" class="btn btn-s btn-lg">Funktionen ansehen</a>
        </div>
        <p class="micro rv an" style="--d:4">
          Für <b>Windows</b> und <b>Linux</b> · macOS <span class="wip">in Arbeit</span> · kostenlos für Alpha-Tester
        </p>
      </div>
      <ul class="held-merkmale" aria-label="Auf einen Blick">
        <li class="rv an" style="--d:5">
          <span class="rund"><Icon name="user-x" size={18} /></span>
          <div><b>Kein Konto</b><span>Installieren, loslegen. Keine Registrierung.</span></div>
        </li>
        <li class="rv an" style="--d:6">
          <span class="rund"><Icon name="cpu" size={18} /></span>
          <div><b>Eigene oder lokale KI</b><span>Eigener Schlüssel oder Ollama / LM Studio.</span></div>
        </li>
        <li class="rv an" style="--d:7">
          <span class="rund"><Icon name="server-off" size={18} /></span>
          <div><b>Daten bleiben bei dir</b><span>Kein Server, der deine Bewerbungen sieht.</span></div>
        </li>
      </ul>
    </div>
  </section>

  <!-- ───────── Einblick (Screenshots) ───────── -->
  <section class="abschnitt einblick">
    <div class="wrap">
      <div class="abschnitt-kopf center">
        <div class="eyebrow rv">Einblick</div>
        <h2 class="rv" style="--d:1">So sieht cockpit aus.</h2>
      </div>
      <div class="held-slider rv" style="--d:2">
        <ScreenSlider folien={folien} />
      </div>
    </div>
  </section>

  <!-- ───────── Quellen-Band ───────── -->
  <section class="band" aria-label="Funktioniert mit">
    <p class="micro center">Funktioniert mit</p>
    <div class="laufband">
      <div class="spur">
        <ul>
          {quellen.map((q) => <li>{q}</li>)}
        </ul>
        {[1, 2, 3].map(() => (
          <ul aria-hidden="true">
            {quellen.map((q) => <li>{q}</li>)}
          </ul>
        ))}
      </div>
    </div>
  </section>

  <!-- ───────── Problem ───────── -->
  <section class="abschnitt">
    <div class="wrap">
      <div class="abschnitt-kopf">
        <div class="eyebrow rv">Das Problem</div>
        <h2 class="rv" style="--d:1">Bewerben ist Projektarbeit. Nur meist ohne Werkzeug.</h2>
        <p class="lead rv" style="--d:2">
          Fünf Portale, drei Postfächer, eine Tabelle, die niemand pflegt. Und ein Anschreiben, das 45 Minuten kostet und trotzdem generisch klingt.
        </p>
      </div>
      <div class="raster r3">
        <div class="karte rv" style="--d:1">
          <div class="ic"><Icon name="list-checks" /></div>
          <h3>Kein Überblick</h3>
          <p>Wo hast du dich beworben? Wann war das? Wer hat sich nie gemeldet? Nach der zwanzigsten Bewerbung weiß das niemand mehr.</p>
        </div>
        <div class="karte rv" style="--d:2">
          <div class="ic"><Icon name="clock" /></div>
          <h3>Anschreiben fressen Zeit</h3>
          <p>30 bis 60 Minuten pro Stück. ChatGPT hilft, aber du kopierst deinen Werdegang jedes Mal neu hinein.</p>
        </div>
        <div class="karte rv" style="--d:3">
          <div class="ic"><Icon name="shield-check" /></div>
          <h3>Deine Daten auf fremden Servern</h3>
          <p>Gehalt, Kündigungsgründe, Absagen, aktueller Arbeitgeber. Die gängigen Tools laden all das in ihre Cloud.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ───────── Funktionen (Karussell) ───────── -->
  <section class="abschnitt soft">
    <div class="wrap">
      <CardRail label="Funktionen">
        <div slot="kopf">
          <div class="eyebrow rv">Die Lösung</div>
          <h2 class="rv" style="--d:1">Alles an einem Ort. Auf deinem Gerät.</h2>
          <p class="lead rv" style="--d:2">Zehn Werkzeuge, die auf dieselben Daten zugreifen.</p>
        </div>
        {
          funktionen.map((f) => (
            <li>
              <a href={`/funktionen/${f.id}/`} class="karte funktion">
                <div class="ic">
                  <Icon name={f.data.icon} />
                </div>
                <h3>{f.data.titel}</h3>
                <p>{f.data.kurz}</p>
                <span class="mehr">
                  Mehr erfahren <Icon name="arrow-right" size={15} />
                </span>
              </a>
            </li>
          ))
        }
      </CardRail>
    </div>
  </section>

  <!-- ───────── So geht's ───────── -->
  <section class="abschnitt">
    <div class="wrap">
      <div class="abschnitt-kopf center">
        <div class="eyebrow rv">So geht's</div>
        <h2 class="rv" style="--d:1">In zehn Minuten startklar.</h2>
      </div>
      <ol class="ablauf">
        <li class="rv" style="--d:1">
          <span class="schritt-nr">1</span>
          <h3>Installieren</h3>
          <p>Installer für Windows oder Linux laden und starten. Kein Konto, keine Registrierung.</p>
        </li>
        <li class="rv" style="--d:2">
          <span class="schritt-nr">2</span>
          <h3>Lebenslauf einlesen</h3>
          <p>cockpit baut daraus dein Profil. Darauf bauen Suche, Match-Score und Anschreiben auf.</p>
        </li>
        <li class="rv" style="--d:3">
          <span class="schritt-nr">3</span>
          <h3>Stellen finden, bewerben</h3>
          <p>Treffer übernehmen, Anschreiben entwerfen lassen, in der Pipeline verfolgen.</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ───────── Erweiterung & Sync ───────── -->
  <section class="abschnitt soft">
    <div class="wrap">
      <div class="abschnitt-kopf">
        <div class="eyebrow rv">Drumherum</div>
        <h2 class="rv" style="--d:1">Im Browser speichern. Auf jedem Gerät weiterarbeiten.</h2>
      </div>
      <div class="raster r2">
        <a href="/funktionen/browser-erweiterung/" class="karte rv" style="--d:1">
          <div class="ic"><Icon name="puzzle" /></div>
          <h3>Browser-Erweiterung für Chrome und Edge</h3>
          <p>Du liest eine Anzeige auf StepStone, Indeed oder der Jobbörse der Arbeitsagentur? Ein Klick, und sie liegt als Entwurf in cockpit. Mit Pro füllt die Erweiterung auch Bewerbungsformulare aus. Sie redet nur mit cockpit auf deinem Rechner.</p>
          <span class="mehr">Zur Erweiterung <Icon name="arrow-right" size={15} /></span>
        </a>
        <a href="/funktionen/geraete-sync/" class="karte rv" style="--d:2">
          <div class="ic"><Icon name="refresh-cw" /></div>
          <h3>Geräte-Sync, verschlüsselt</h3>
          <p>Laptop und PC auf demselben Stand: kostenlos über einen Ordner in deinem Cloud-Speicher oder mit Pro über den cockpit-Server. Verschlüsselt wird vorher auf deinem Gerät, mit einer Passphrase, die nur du kennst.</p>
          <span class="mehr">Wie der Sync funktioniert <Icon name="arrow-right" size={15} /></span>
        </a>
      </div>
    </div>
  </section>

  <!-- ───────── Datenschutz ───────── -->
  <section class="abschnitt" id="datenschutz">
    <div class="wrap zwei">
      <div>
        <div class="eyebrow rv">Datenschutz</div>
        <h2 class="rv" style="--d:1">Das ist keine Funktion. Das ist die Architektur.</h2>
        <p class="lead rv" style="--d:2">
          Bewerbungsdaten gehören zu den sensibelsten Daten, die du hast. cockpit ist so gebaut, dass sie auf deinem Gerät bleiben. Es gibt kein Konto und keinen Server, der deine Bewerbungen im Klartext annimmt. Gleichst du Geräte ab, gehen nur verschlüsselte Pakete raus.
        </p>
        <div class="chips rv" style="--d:3">
          <span class="chip"><i></i>SQLite auf deiner Festplatte</span>
          <span class="chip"><i></i>Schlüssel im System-Schlüsselbund</span>
          <span class="chip"><i></i>Kein Konto</span>
          <span class="chip"><i></i>Keine Telemetrie</span>
          <span class="chip"><i></i>Nur offizielle Stellenquellen</span>
        </div>
        <a href="/blog/warum-local-first/" class="mehr rv" style="--d:4">Alles, was cockpit ins Netz schickt <Icon name="arrow-right" size={15} /></a>
      </div>
      <div class="raster">
        <div class="karte rv" style="--d:2">
          <div class="ic"><Icon name="cpu" /></div>
          <h3>Bring deine eigene KI mit</h3>
          <p>Eigener API-Schlüssel beim Anbieter deiner Wahl oder ein lokales Modell über Ollama oder LM Studio. Deine Texte gehen nie über mich.</p>
        </div>
        <div class="karte rv" style="--d:3">
          <div class="ic"><Icon name="wallet" /></div>
          <h3>Warum das den Preis senkt</h3>
          <p>Keine Server und keine KI-Kosten pro Nutzer heißt: cockpit muss kein Abo sein, das jeden Monat die Rechnung deckt.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ───────── Vergleich ───────── -->
  <section class="abschnitt soft" id="vergleich">
    <div class="wrap">
      <div class="abschnitt-kopf">
        <div class="eyebrow rv">Vergleich</div>
        <h2 class="rv" style="--d:1">Warum nicht einfach Teal, Huntr oder Excel?</h2>
        <p class="lead rv" style="--d:2">Teal und Huntr sind gute Werkzeuge. Sie sind nur für einen anderen Markt gebaut und speichern alles bei sich.</p>
      </div>
      <div class="rv" style="--d:2">
        <Vergleich kompakt />
      </div>
      <p style="margin-top:18px"><a href="/vergleich/" class="mehr">Alle Unterschiede, auch wo Teal und Huntr vorn liegen <Icon name="arrow-right" size={15} /></a></p>
    </div>
  </section>

  <!-- ───────── Preis & Alpha ───────── -->
  <section class="abschnitt">
    <div class="wrap">
      <div class="alpha-band rv">
        <div>
          <div class="eyebrow">Geschlossene Alpha</div>
          <h2>{SITE.alphaPlaetze} Plätze. Kostenlos. Und du behältst sie.</h2>
          <p>
            Die App läuft bei mir. Jetzt muss sie auf fremden Rechnern bestehen. Dafür suche ich Menschen, die gerade wirklich auf Jobsuche sind. Wer bis zum Ende Rückmeldung gibt, behält die Vollversion dauerhaft.
          </p>
          <p class="micro" data-alpha-plaetze hidden></p>
        </div>
        <div class="alpha-knoepfe">
          <a href="/alpha/" class="btn btn-p btn-lg">Jetzt anmelden <Icon name="arrow-right" size={17} /></a>
          <a href="/preise/" class="btn btn-s">Preis noch offen, du bestimmst mit</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ───────── Blog ───────── -->
  <section class="abschnitt soft">
    <div class="wrap">
      <div class="abschnitt-kopf kopf-zeile">
        <div>
          <div class="eyebrow rv">Aus dem Blog</div>
          <h2 class="rv" style="--d:1">Hintergründe und Tipps</h2>
        </div>
        <a href="/blog/" class="btn btn-s btn-sm rv">Alle Beiträge</a>
      </div>
      <div class="raster r3">
        {
          beitraege.map((b, i) => (
            <a href={`/blog/${b.id}/`} class="karte beitrag rv" style={`--d:${i + 1}`}>
              <span class="micro">
                {b.data.tags[0]} · {lesezeit(b.body)} Min.
              </span>
              <h3>{b.data.titel}</h3>
              <p>{b.data.beschreibung}</p>
              <span class="mehr">
                Lesen <Icon name="arrow-right" size={15} />
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ───────── Fragen ───────── -->
  <section class="abschnitt">
    <div class="wrap eng">
      <div class="abschnitt-kopf">
        <div class="eyebrow rv">Fragen</div>
        <h2 class="rv" style="--d:1">Was die meisten wissen wollen</h2>
      </div>
      <div class="rv" style="--d:2"><Faq fragen={fragen} ersteOffen /></div>
      <p class="micro" style="margin-top:22px">Mehr im <a href="/hilfe/">Hilfe-Center</a>.</p>
    </div>
  </section>
</Base>

<style>
  .held {
    position: relative;
    isolation: isolate;
    min-height: min(900px, calc(100svh - 68px));
    display: flex;
    align-items: center;
    padding: clamp(48px, 6vw, 72px) 0 clamp(36px, 4vw, 56px);
    /* Nur seitlich abschneiden: Der Verlauf darf unten in den nächsten Abschnitt auslaufen. */
    overflow-x: clip;
  }
  .held + .abschnitt {
    position: relative;
    z-index: 1;
  }
  .held-inhalt {
    position: relative;
    z-index: 1;
    width: 100%;
    display: grid;
    gap: clamp(40px, 5vw, 64px);
  }
  .held-text {
    max-width: 820px;
  }
  .held h1 {
    font-size: clamp(40px, 6vw, 76px);
    font-weight: 300;
    letter-spacing: -0.05em;
    line-height: 1.02;
    margin: 24px 0 22px;
    text-wrap: initial;
  }
  .zeile {
    display: block;
  }
  @media (min-width: 700px) {
    .zeile {
      white-space: nowrap;
    }
  }
  .held .lead {
    max-width: 580px;
  }
  .verlauf {
    background: linear-gradient(90deg, #4f46e5, #06b6d4);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    font-weight: 400;
  }
  :global([data-theme="dark"]) .verlauf {
    background-image: linear-gradient(90deg, #818cf8, #22d3ee);
  }
  .held .lead {
    margin-bottom: 32px;
  }
  .held .lead b {
    color: var(--ink);
    font-weight: 500;
  }
  .cta {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 18px;
  }
  .held-merkmale {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 260px));
    gap: 16px 40px;
    padding-top: 28px;
    border-top: 1px solid color-mix(in srgb, var(--line) 80%, transparent);
    max-width: 900px;
  }
  .held-merkmale li {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }
  .rund {
    width: 40px;
    height: 40px;
    flex: none;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--accent-soft);
    color: var(--accent-ink);
    border: 1px solid var(--accent-line);
  }
  .held-merkmale b {
    display: block;
    font-weight: 500;
    font-size: 15px;
  }
  .held-merkmale span:not(.rund) {
    display: block;
    margin-top: 2px;
    font-size: 13.5px;
    color: var(--muted);
    line-height: 1.45;
  }
  @media (max-width: 900px) {
    .held {
      min-height: 0;
    }
    .held-merkmale {
      grid-template-columns: 1fr;
    }
  }
  .einblick {
    padding-top: clamp(48px, 6vw, 72px);
  }
  .held-slider {
    max-width: 1100px;
    margin: 0 auto;
  }

  .band {
    padding: 26px 0 30px;
    border-block: 1px solid var(--line);
  }
  .laufband {
    display: flex;
    overflow: hidden;
    margin-top: 12px;
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
  }
  /* Vier gleiche Listen: Die Spur wandert um genau die Hälfte (zwei Listen) und
     springt dann nahtlos zurück. Zwei Listen sind breiter als jeder Bildschirm,
     so entsteht auch auf großen Monitoren keine Lücke hinter dem letzten Eintrag. */
  .spur {
    display: flex;
    flex: none;
  }
  .laufband ul {
    display: flex;
    flex: none;
    gap: 44px;
    padding-right: 44px;
    list-style: none;
    font-weight: 650;
    font-size: 15px;
    color: var(--faint);
    white-space: nowrap;
  }
  @media (prefers-reduced-motion: no-preference) {
    .spur {
      animation: laufen 76s linear infinite;
    }
    .laufband:hover .spur {
      animation-play-state: paused;
    }
    @keyframes laufen {
      to {
        transform: translateX(-50%);
      }
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .laufband {
      mask-image: none;
    }
    .spur {
      flex: 1;
      min-width: 0;
    }
    .laufband ul {
      flex: 1;
      flex-wrap: wrap;
      justify-content: center;
      white-space: normal;
      gap: 12px 28px;
      padding: 0 22px;
    }
    .laufband ul[aria-hidden] {
      display: none;
    }
  }

  .funktion {
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .funktion .mehr {
    margin-top: auto;
    padding-top: 14px;
  }

  .ablauf {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 26px;
    position: relative;
  }
  .ablauf::before {
    content: "";
    position: absolute;
    top: 22px;
    left: 16%;
    right: 16%;
    height: 2px;
    background: linear-gradient(90deg, var(--accent), color-mix(in srgb, var(--accent) 30%, transparent));
    opacity: 0.35;
  }
  .ablauf li {
    text-align: center;
    position: relative;
  }
  .schritt-nr {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    margin: 0 auto 16px;
    background: var(--card);
    border: 2px solid var(--accent);
    color: var(--accent-ink);
    font-weight: 750;
    font-size: 18px;
