---
import Base from "../layouts/Base.astro";
import Seitenkopf from "../components/Seitenkopf.astro";
import Icon from "../components/Icon.astro";
import { SITE } from "../config";

/** Neueste Version oben. Texte für Nutzer; die technische Fassung steht im App-Repo. */
const versionen = [
  {
    version: "0.1.0",
    titel: "0.1 Alpha",
    datum: "Alpha-Start, Herbst 2026",
    intro: "Die erste Version für Tester, für Windows und Linux.",
    neu: [
      "Bewerbungen ohne Grenze, auch kostenlos. Pro bringt Komfortfunktionen, die Zahl der Bewerbungen begrenzt es nicht.",
      "Bewerbung im Detail: Gehalt, Arbeitsort, Tags, Priorität, Verlauf, Notizen, Kontakte, Aufgaben und Dokumente in einem Seitenpanel.",
      "Stichwort-Abgleich: welche Anforderungen der Anzeige in Profil und Lebenslauf stehen und welche fehlen. Kostenlos, mit KI genauer.",
      "Lebenslauf für eine bestimmte Stelle (Pro): Kurzprofil und Reihenfolge passen sich an, ohne dass etwas erfunden wird.",
      "Mail-Vorlagen für Nachfassen, Dank nach dem Gespräch und Antworten auf Angebote.",
      "Kontakte als eigene Ansicht, Wochenziel auf der Startseite, Termine als .ics für den Kalender.",
      "Browser-Erweiterung für Chrome und Edge: Stellen mit einem Klick speichern, Formulare ausfüllen (Pro).",
      "Geräte-Sync über deinen eigenen Cloud-Ordner oder den cockpit-Server (Pro), Ende-zu-Ende verschlüsselt.",
      "Lebenslauf-Scan liest PDFs aus Word und Canva und auch .docx-Dateien.",
      "Jede Aktion meldet sich: was geklappt hat, was nicht und was als Nächstes zu tun ist. Bei echten Fehlern geht „Fehler melden“ mit Protokoll.",
      "Interview-Training, Lebenslauf-Designer, Arbeitnow und Adzuna als Stellenquellen.",
      "Automatische Updates: Hinweis bei neuer Version, Installation auf Klick.",
      "Feedback aus der App: kurze Umfragen und „Fehler melden“ mit Vorschau, was gesendet wird.",
    ],
    geaendert: [
      "Neues Logo, überall gleich.",
      "Installer auf Deutsch, zusätzlich als MSI für Firmenrechner.",
      "Eine gesperrte oder abgelaufene Lizenz wird nicht mehr gelöscht. cockpit zeigt den Grund und läuft als Kostenlos weiter.",
      "Der frühere Supabase-Sync ist durch den verschlüsselten Geräte-Sync ersetzt.",
      "Robuster: Ein Fehler in einer Ansicht betrifft nur diese Ansicht, nicht die ganze App.",
      "macOS ist vorerst in Arbeit.",
    ],
  },
];
---

<Base title="Changelog" description="Alle Änderungen an cockpit je Version: neue Funktionen, Verbesserungen, behobene Fehler.">
  <Seitenkopf eyebrow="Changelog" titel="Was sich geändert hat" lead="Jede Version mit ihren Neuerungen. Updates bekommst du direkt in der App." krumen={[["Changelog", "/changelog/"]]} />
  <section class="abschnitt">
    <div class="wrap eng">
      <ol class="zeitleiste">
        {
          versionen.map((v) => (
            <li class="rv" id={`v${v.version}`}>
              <div class="marke" aria-hidden="true" />
              <div class="eintrag karte">
                <div class="kopf">
                  <span class="badge">v{v.version}</span>
                  <span class="micro">{v.datum}</span>
                </div>
                <h2>{v.titel}</h2>
                <p class="muted">{v.intro}</p>
                <h3><Icon name="sparkles" size={16} /> Neu</h3>
                <ul>{v.neu.map((n) => <li>{n}</li>)}</ul>
                <h3><Icon name="git-commit" size={16} /> Geändert</h3>
                <ul>{v.geaendert.map((n) => <li>{n}</li>)}</ul>
              </div>
            </li>
          ))
        }
      </ol>
      <p class="micro" style="margin-top:28px">Technische Details und alle Versionen: <a href={SITE.releases}>Releases auf GitHub</a>.</p>
    </div>
  </section>
</Base>

<style>
  .zeitleiste {
    list-style: none;
    position: relative;
    padding-left: 30px;
  }
  .zeitleiste::before {
    content: "";
    position: absolute;
    left: 7px;
    top: 8px;
    bottom: 8px;
    width: 2px;
    background: linear-gradient(var(--accent), var(--line));
  }
  .zeitleiste li {
    position: relative;
  }
  .zeitleiste li + li {
    margin-top: 28px;
  }
  .marke {
    position: absolute;
    left: -30px;
    top: 26px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 5px var(--accent-soft);
  }
  .eintrag {
    padding: 26px 28px;
  }
  .kopf {
    display: flex;
    gap: 12px;
    align-items: center;
    flex-wrap: wrap;
  }
  .eintrag h2 {
    font-size: 24px;
    margin: 12px 0 4px;
  }
  .eintrag h3 {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent-ink);
    margin: 22px 0 8px;
  }
  .eintrag ul {
    padding-left: 20px;
    display: grid;
    gap: 6px;
    color: var(--ink-2);
    font-size: 15px;
  }
</style>
